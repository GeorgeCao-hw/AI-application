%global goipath         {{ go_import_path }}
{% if git_commit %}
%global commit          {{ git_commit }}
%global shortcommit     %(c=%{commit}; echo ${c:0:7})
{% endif %}

Name:           {{ rpm_name }}
Version:        {{ version }}
Release:        {{ release }}%{?dist}
Summary:        {{ summary }}

License:        {{ license }}
URL:            {{ url }}
Source0:        {{ source_url }}

BuildRequires:  golang >= 1.20
{% for dep in build_requires %}
BuildRequires:  golang({{ dep }})
{% endfor %}

%description
{{ description }}

%package devel
Summary:        %{summary}
BuildArch:      noarch

Provides:       golang(%{goipath}) = %{version}-%{release}

%description devel
%{summary}

This package contains library source intended for building other packages
which use import path with %{goipath} prefix.

%prep
%autosetup -n %{name}-%{version}

%build
export GO111MODULE=on
export GOPROXY=https://goproxy.cn,direct
# Build is not required for library packages
# go build -v -mod=readonly -ldflags "-linkmode=external" .

%install
install -d %{buildroot}%{_datadir}/gocode/src/%{goipath}
cp -rpav * %{buildroot}%{_datadir}/gocode/src/%{goipath}/

%check
# Tests may require network or additional dependencies
# go test -v ./...

%files devel
%license LICENSE*
%doc README* CHANGELOG* CONTRIBUTING*
%{_datadir}/gocode/src/%{goipath}

%changelog
* {{ date }} {{ packager }} - {{ version }}-{{ release }}
- Initial package generated by Claude4RPM
